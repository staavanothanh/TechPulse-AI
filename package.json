{
  "name": "techpulse-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "setup:hooks": "node scripts/setup-git-hooks.js",
    "attestation:local": "node --env-file-if-exists=.env scripts/update-local-attestation.js",
    "build": "vite build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:atlas": "node --env-file-if-exists=.env scripts/run-atlas-tests.js",
    "test:coverage:mongodb": "node --env-file-if-exists=.env scripts/run-atlas-tests.js coverage",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:security": "vitest run test/security",
    "test:ui": "vitest run test/ui",
    "test:e2e": "vitest run test/e2e",
    "test:e2e:local": "node --env-file-if-exists=.env scripts/run-local-e2e.js",
    "test:e2e:vercel": "node --env-file-if-exists=.env scripts/run-vercel-e2e.js",
    "eval:retrieval": "node scripts/eval-retrieval.js",
    "eval:groundedness": "node scripts/eval-groundedness.js",
    "eval:citations": "node scripts/eval-citations.js",
    "smoke:gemini": "node --env-file-if-exists=.env scripts/gemini-llm-smoke.js",
    "smoke:deepseek:v4-flash": "node --env-file-if-exists=.env scripts/deepseek-v4-flash-smoke.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.js",
    "db:migrate:dry-run": "node --env-file-if-exists=.env scripts/db-migrate.js --dry-run",
    "db:verify": "node --env-file-if-exists=.env scripts/db-verify.js",
    "seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.js",
    "seed:e2e-user": "node --env-file-if-exists=.env scripts/seed-e2e-user.js",
    "seed:sources": "node --env-file-if-exists=.env scripts/seed-sources.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "verify:demo": "node --env-file-if-exists=.env scripts/verify-demo.js",
    "contract:validate": "node scripts/contracts/validate-openapi.js",
    "contract:generate": "node scripts/contracts/generate.js",
    "contract:test": "node scripts/contracts/test-contract.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "fast-xml-parser": "5.10.1",
    "mongodb": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "prettier": "3.9.6",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
