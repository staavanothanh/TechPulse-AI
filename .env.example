PUBLIC_APP_ORIGINS=http://localhost:3000

MONGODB_URI_ENV=MONGODB_URI
MONGODB_URI=mongodb+srv://<username_custom_role>:<password>@cluster0.jcupv4z.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=techpulse_app

MONGODB_MAINTENANCE_URI_ENV=MONGODB_MAINTENANCE_URI
MONGODB_MAINTENANCE_URI=mongodb+srv://<username_maintenance_role>:<password>@cluster0.jcupv4z.mongodb.net/?appName=Cluster0

MONGODB_OPERATOR_URI_ENV=MONGODB_OPERATOR_URI
MONGODB_OPERATOR_URI=mongodb+srv://<username_admin>:<password>@cluster0.jcupv4z.mongodb.net/?appName=Cluster0

QUOTA_HMAC_CURRENT_KEY_ENV=QUOTA_HMAC_CURRENT_KEY
