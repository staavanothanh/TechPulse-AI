    { "routeId": "summary-provider-fallback", "providerId": "openrouter", "admissionDomainId": "openrouter-main", "model": "openai/gpt-4o-mini", "operations": ["summary"], "capability": "nonconfidential", "evidenceUrl": "https://openrouter.ai/docs", "reviewedAt": "2026-08-15T00:00:00.000Z", "evidenceExpiresAt": "2026-11-13T00:00:00.000Z", "artifactCompatibilityId": null, "enabled": true, "routeFailureThreshold": 3, "routeCooldownSeconds": 60 },
