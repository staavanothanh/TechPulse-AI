PUBLIC_APP_ORIGINS=http://localhost:3000

MONGODB_URI_ENV=MONGODB_URI
MONGODB_URI=mongodb+srv://<username_custom_role>:<password>@cluster0.jcupv4z.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=techpulse_app

MONGODB_MAINTENANCE_URI_ENV=MONGODB_MAINTENANCE_URI
MONGODB_MAINTENANCE_URI=mongodb+srv://<username_maintenance_role>:<password>@cluster0.jcupv4z.mongodb.net/?appName=Cluster0

MONGODB_OPERATOR_URI_ENV=MONGODB_OPERATOR_URI
MONGODB_OPERATOR_URI=mongodb+srv://<username_admin>:<password>@cluster0.jcupv4z.mongodb.net/?appName=Cluster0

QUOTA_HMAC_CURRENT_KEY_ENV=QUOTA_HMAC_CURRENT_KEY
QUOTA_HMAC_CURRENT_KEY=<key>
QUOTA_HMAC_RETIRING_KEY_ENVS=
QUOTA_HMAC_CURRENT_KEY_VERSION=1
QUOTA_HMAC_RETIRING_KEY_VERSIONS=

GOVERNANCE_SIGNING_CURRENT_KEY_ENV=GOVERNANCE_SIGNING_CURRENT_KEY
GOVERNANCE_SIGNING_CURRENT_KEY=<key>
GOVERNANCE_SIGNING_RETIRING_KEY_ENVS=
# Gemini cutover target: summary, Q&A generation and Q&A support use the
# Gemini OpenAI-compatible endpoint. Keep embedding on OpenRouter/BGE-M3.
# Replace the example Gemini model IDs and Q&A evidence with values reviewed
# for the Google AI Studio project before enabling real traffic. Do not treat
# a free AI Studio key as `zdr-verified`; Q&A must fail closed without project
# level ZDR evidence.
OFFLINE_CHECKPOINT_KEY_IDS=checkpoint-current
PROVIDER_ADMISSION_DOMAINS_JSON='{
  "providerFailureDomains": [
    { "providerFailureDomainId": "gemini-control-plane", "configVersion": 1, "failureThreshold": 3, "cooldownSeconds": 60 },
    { "providerFailureDomainId": "openrouter-control-plane", "configVersion": 1, "failureThreshold": 3, "cooldownSeconds": 60 }
  ],
  "providers": [
    { "providerId": "gemini", "providerFailureDomainId": "gemini-control-plane", "adapterId": "openai-compatible", "trustedEndpointProfileId": "gemini-ai-studio-openai-v1" },
    { "providerId": "openrouter", "providerFailureDomainId": "openrouter-control-plane", "adapterId": "openai-compatible", "trustedEndpointProfileId": "openrouter-v1" }
  ],
  "admissionDomains": [
    { "admissionDomainId": "gemini-main", "providerId": "gemini", "credentialEnvName": "GEMINI_API_KEY", "maxConcurrency": 2, "budgetLimit": 1000, "budgetWindow": "day" },
    { "admissionDomainId": "openrouter-main", "providerId": "openrouter", "credentialEnvName": "EMBEDDING_API_KEY", "maxConcurrency": 2, "budgetLimit": 1000, "budgetWindow": "day" }
  ],
  "routes": [
    { "routeId": "summary-primary", "providerId": "gemini", "admissionDomainId": "gemini-main", "model": "gemini-2.5-flash", "operations": ["summary"], "capability": "nonconfidential", "evidenceUrl": "https://ai.google.dev/gemini-api/docs/openai", "reviewedAt": "2026-08-21T00:00:00.000Z", "evidenceExpiresAt": "2026-11-19T00:00:00.000Z", "artifactCompatibilityId": null, "enabled": true, "routeFailureThreshold": 3, "routeCooldownSeconds": 60 },
    { "routeId": "summary-model-fallback", "providerId": "gemini", "admissionDomainId": "gemini-main", "model": "gemini-2.5-flash-lite", "operations": ["summary"], "capability": "nonconfidential", "evidenceUrl": "https://ai.google.dev/gemini-api/docs/openai", "reviewedAt": "2026-08-21T00:00:00.000Z", "evidenceExpiresAt": "2026-11-19T00:00:00.000Z", "artifactCompatibilityId": null, "enabled": true, "routeFailureThreshold": 3, "routeCooldownSeconds": 60 },
    { "routeId": "qa-primary", "providerId": "gemini", "admissionDomainId": "gemini-main", "model": "gemini-2.5-flash", "operations": ["answer"], "capability": "zdr-verified", "evidenceUrl": "https://ai.google.dev/gemini-api/docs/zdr", "reviewedAt": "2026-08-21T00:00:00.000Z", "evidenceExpiresAt": "2026-11-19T00:00:00.000Z", "artifactCompatibilityId": null, "enabled": true, "routeFailureThreshold": 3, "routeCooldownSeconds": 60 },
    { "routeId": "qa-support", "providerId": "gemini", "admissionDomainId": "gemini-main", "model": "gemini-2.5-flash", "operations": ["support"], "capability": "zdr-verified", "evidenceUrl": "https://ai.google.dev/gemini-api/docs/zdr", "reviewedAt": "2026-08-21T00:00:00.000Z", "evidenceExpiresAt": "2026-11-19T00:00:00.000Z", "artifactCompatibilityId": null, "enabled": true, "routeFailureThreshold": 3, "routeCooldownSeconds": 60 },
    { "routeId": "embedding-primary", "providerId": "openrouter", "admissionDomainId": "openrouter-main", "model": "baai/bge-m3", "operations": ["embedding"], "capability": "nonconfidential", "evidenceUrl": "https://openrouter.ai/baai/bge-m3/providers", "reviewedAt": "2026-08-15T00:00:00.000Z", "evidenceExpiresAt": "2026-11-13T00:00:00.000Z", "artifactCompatibilityId": "bge-m3-v1-1024", "embeddingDimensions": 1024, "embeddingVersion": 1, "enabled": true, "routeFailureThreshold": 3, "routeCooldownSeconds": 60 }
  ],
  "workloadPolicies": [
    { "workloadId": "summary", "operation": "summary", "requiredCapability": "nonconfidential", "maxExternalAttempts": 2, "primaryRouteId": "summary-primary", "modelFallbackRouteIds": ["summary-model-fallback"], "providerFallbackRouteIds": [] },
    { "workloadId": "qa-generation", "operation": "answer", "requiredCapability": "zdr-verified", "maxExternalAttempts": 2, "primaryRouteId": "qa-primary", "modelFallbackRouteIds": [], "providerFallbackRouteIds": [] },
    { "workloadId": "qa-support", "operation": "support", "requiredCapability": "zdr-verified", "maxExternalAttempts": 1, "primaryRouteId": "qa-support", "modelFallbackRouteIds": [], "providerFallbackRouteIds": [] },
    { "workloadId": "embedding", "operation": "embedding", "requiredCapability": "nonconfidential", "maxExternalAttempts": 1, "primaryRouteId": "embedding-primary", "modelFallbackRouteIds": [], "providerFallbackRouteIds": [] }
  ]
}'
INTERNAL_MACHINE_SECRET_ENV=CRON_SECRET
CRON_SECRET=<random_value>

# Local demo seed attestation. Keep false until the owner approves metadata-only
# demo policy and supplies an active admin reviewer ObjectId.
DEMO_SOURCE_POLICY_ATTESTED=false
DEMO_SOURCE_REVIEWER_ID=

LLM_PRIMARY_API_KEY_ENV=GEMINI_API_KEY
EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
GEMINI_API_KEY=<google_ai_studio_api_key>
EMBEDDING_API_KEY=sk-or-v1-...

SEED_ADMIN_EMAIL=<gmail>@gmail.com
SEED_ADMIN_PASSWORD=password

# Local-host Vitest E2E. Keep disabled unless a local server is running.
E2E_ENABLED=false
E2E_BASE_URL=http://localhost:3000
E2E_ORIGIN=http://localhost:3000
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SEARCH_QUERY=AI
E2E_REQUIRE_ARTICLES=false
E2E_DEMO_SOURCE_ID=
E2E_DEMO_ARTICLE_ID=
E2E_GOVERNANCE_MUTATIONS=false
E2E_DELETION_EMAIL=
E2E_DELETION_PASSWORD=
E2E_DELETION_CONFIRM_EMAIL=
E2E_SEED_CONFIRM=false
E2E_TAKEDOWN_ARTICLE_ID=

# Vercel Preview API/Cron E2E. Keep disabled outside an actual HTTPS Preview deployment.
E2E_VERCEL_ENABLED=false
E2E_CRON_SECRET=
E2E_VERCEL_PROTECTION_HEADERS_JSON=
